# Example process-environment values. The application does not load .env automatically; never commit real credentials.
DATABASE_URL=postgresql+psycopg://aidscout_user:change-me@localhost:5432/aidscout_dev
AIDSCOUT_EXPECTED_DATABASE_NAME=aidscout_dev
DATABASE_READINESS_TIMEOUT_SECONDS=3
DATABASE_READINESS_STATEMENT_TIMEOUT_MILLISECONDS=3000
VERIFICATION_FRESHNESS_DAYS=90
